# Triton Inference Server
TRITON_URL=localhost:8001
TRITON_MODEL_NAME=rubert_ner
TRITON_TOKENIZER_NAME=ai-forever/ruBert-base

# Upstream LLM
LLM_BASE_URL=http://localhost:8000/v1
